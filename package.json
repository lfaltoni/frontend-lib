{
  "name": "fsdk-ts",
  "version": "1.0.0",
  "description": "Reusable frontend library for foundation-sdk applications",
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./utils/pagination": {
      "types": "./dist/utils/pagination.d.ts",
      "import": "./dist/utils/pagination.js",
      "require": "./dist/cjs/utils/pagination.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/cjs/types/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.js",
      "require": "./dist/cjs/email/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/cjs/server/index.js"
    },
    "./seo": {
      "types": "./dist/utils/seo.d.ts",
      "import": "./dist/utils/seo.js",
      "require": "./dist/cjs/utils/seo.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.json && tsc --build tsconfig.cjs.json",
    "build:cjs": "tsc --build tsconfig.cjs.json",
    "build:esm": "tsc --build tsconfig.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react",
    "frontend",
    "foundation-sdk",
    "auth"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^20.9.2",
    "@types/nodemailer": "^7.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "react": "^19.2.3"
  },
  "peerDependencies": {
    "@tanstack/react-table": ">=8.0.0",
    "nodemailer": ">=6.0.0",
    "react": "^19.2.3"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
